      "type": "text",
      "color": "#f2c94c",
      "content": {
        "text": "Dense Passage Retriever",
        "image": null
      },
      "position": {
        "page": 2,
        "boundingRect": {
          "page": 2,
          "x": 0.23699481670673078,
          "y": 0.4263986013986014,
          "width": 0.16397589083710407,
          "height": 0.014685314685314685
